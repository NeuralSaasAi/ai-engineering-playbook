# Copy to .env and fill in. Never commit .env.
# Tests and the default load test use a fake model and need no keys.

# Real model (LIVE=1). Default: Google Gemini free tier. Key: https://aistudio.google.com/apikey
LIVE=0
GEMINI_API_KEY=
MODEL=gemini/gemini-3.5-flash-lite
# Other providers: OPENAI_API_KEY / ANTHROPIC_API_KEY with MODEL=openai/... or anthropic/...
# Local, free: MODEL=ollama/llama3.2 (needs a model that supports tool calling)

# Tracing: send spans to an OpenTelemetry collector or Jaeger (docker compose sets this for you)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Or print spans to the terminal:
# TRACE_TO_CONSOLE=1
