# Copy to .env and fill in. Never commit .env.
# Only needed for --live mode. Tests and evals use a fake model and need no keys.

# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL=gemini/gemini-3.5-flash-lite

# Other providers: set the matching key and change MODEL
# OPENAI_API_KEY=        MODEL=openai/gpt-...
# ANTHROPIC_API_KEY=     MODEL=anthropic/claude-...
# Local, free, no key:   MODEL=ollama/llama3.2
