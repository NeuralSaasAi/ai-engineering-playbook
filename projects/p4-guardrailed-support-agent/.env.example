# Copy to .env and fill in. Never commit .env.
# Only needed for --live / --live-judge / LIVE=1. Tests use a fake model and need no keys.

# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL=gemini/gemini-3.5-flash-lite
# Use a different model family for the judge when you can (reduces self-preference bias)
JUDGE_MODEL=gemini/gemini-3.5-flash-lite

# Other providers: set the matching key and change MODEL / JUDGE_MODEL
# OPENAI_API_KEY=        MODEL=openai/gpt-...
# ANTHROPIC_API_KEY=     MODEL=anthropic/claude-...
# Local, free, no key:   MODEL=ollama/llama3.2   (needs a model that supports tool calling)
