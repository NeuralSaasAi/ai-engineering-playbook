# Copy to .env and fill in. Never commit .env.
# Only needed for --live mode. Tests use a fake model and need no keys.

# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Other providers (change MODEL / EMBEDDING_MODEL to match):
# OPENAI_API_KEY=            MODEL=openai/gpt-...          EMBEDDING_MODEL=openai/text-embedding-3-small
# ANTHROPIC_API_KEY=         MODEL=anthropic/claude-...    (Anthropic has no embedding API; keep a Gemini or OpenAI embedding model)
# Local, free, no key:       MODEL=ollama/llama3.2         EMBEDDING_MODEL=ollama/nomic-embed-text
